    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/medieval-mini#birthplaceOf -->

    <owl:ObjectProperty rdf:about="https://example.org/medieval-mini#birthplaceOf">
        <owl:inverseOf rdf:resource="https://example.org/medieval-mini#bornIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/medieval-mini#Place"/>
        <rdfs:range rdf:resource="https://example.org/medieval-mini#Person"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/medieval-mini#bornIn -->

    <owl:ObjectProperty rdf:about="https://example.org/medieval-mini#bornIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/medieval-mini#childOf -->

    <owl:ObjectProperty rdf:about="https://example.org/medieval-mini#childOf">
        <rdfs:subPropertyOf rdf:resource="https://example.org/medieval-mini#descendantOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://example.org/medieval-mini#Person"/>
        <rdfs:range rdf:resource="https://example.org/medieval-mini#Person"/>
    </owl:ObjectProperty>
    


    <!-- https://example.org/medieval-mini#descendantOf -->

    <owl:ObjectProperty rdf:about="https://example.org/medieval-mini#descendantOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
