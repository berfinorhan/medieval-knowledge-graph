    <!-- https://example.org/medieval-mini#adelaOfFrance -->

    <owl:NamedIndividual rdf:about="https://example.org/medieval-mini#adelaOfFrance">
        <rdf:type rdf:resource="https://example.org/medieval-mini#Person"/>
        <medieval-mini:bornIn rdf:resource="https://example.org/medieval-mini#france"/>
        <medieval-mini:heldTitle rdf:resource="https://example.org/medieval-mini#countessConsortOfFlanders"/>
        <medieval-mini:heldTitle rdf:resource="https://example.org/medieval-mini#duchessConsortOfNormandy"/>
        <medieval-mini:memberOfDynasty rdf:resource="https://example.org/medieval-mini#houseOfCapet"/>
        <rdfs:label xml:lang="en">Adela of France</rdfs:label>
    </owl:NamedIndividual>
    


