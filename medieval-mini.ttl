###  https://example.org/medieval-mini#adelaOfFrance
medieval-mini:adelaOfFrance rdf:type owl:NamedIndividual ,
                                     medieval-mini:Person ;
                            medieval-mini:bornIn medieval-mini:france ;
                            medieval-mini:heldTitle medieval-mini:countessConsortOfFlanders ,
                                                    medieval-mini:duchessConsortOfNormandy ;
                            medieval-mini:memberOfDynasty medieval-mini:houseOfCapet ;
                            rdfs:label "Adela of France"@en .


