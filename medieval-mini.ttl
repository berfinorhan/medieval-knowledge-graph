#################################################################

###  https://example.org/medieval-mini#battleOfHastings
medieval-mini:battleOfHastings rdf:type owl:NamedIndividual ,
                                        medieval-mini:HistoricalEvent ;
                               rdfs:label "Battle of Hastings"@en .


###  https://example.org/medieval-mini#battleOfTinchebray
medieval-mini:battleOfTinchebray rdf:type owl:NamedIndividual ,
                                          medieval-mini:HistoricalEvent ;
                                 rdfs:label "Battle of Tinchebray"@en .


###  https://example.org/medieval-mini#domesdayBook
medieval-mini:domesdayBook rdf:type owl:NamedIndividual ,
                                    medieval-mini:Manuscript ;
                           medieval-mini:producedIn medieval-mini:england ;
                           rdfs:label "Domesday Book"@en .


###  https://example.org/medieval-mini#england
medieval-mini:england rdf:type owl:NamedIndividual ,
                               medieval-mini:PoliticalTerritory ;
                      rdfs:label "England"@en .


###  https://example.org/medieval-mini#falaise
medieval-mini:falaise rdf:type owl:NamedIndividual ,
                               medieval-mini:Place ;
                      medieval-mini:locatedIn medieval-mini:normandy ;
                      rdfs:label "Falaise"@en .


###  https://example.org/medieval-mini#hastings
medieval-mini:hastings rdf:type owl:NamedIndividual ,
                                medieval-mini:Place ;
                       medieval-mini:locatedIn medieval-mini:england ;
                       rdfs:label "Hasting"@en .


###  https://example.org/medieval-mini#henryI
medieval-mini:henryI rdf:type owl:NamedIndividual ,
                              medieval-mini:Person ;
                     medieval-mini:bornIn medieval-mini:england ;
                     medieval-mini:marriedTo medieval-mini:matildaOfScotland ;
                     medieval-mini:ruledTerritory medieval-mini:england ;
                     rdfs:label "Henry I of England"@en .


###  https://example.org/medieval-mini#matildaOfFlanders
medieval-mini:matildaOfFlanders rdf:type owl:NamedIndividual ,
                                         medieval-mini:Person ;
                                rdfs:label "Matilda of Flanders"@en .


###  https://example.org/medieval-mini#matildaOfScotland
medieval-mini:matildaOfScotland rdf:type owl:NamedIndividual ,
                                         medieval-mini:Person ;
                                rdfs:label "Matilda of Scotland"@en .


###  https://example.org/medieval-mini#normandy
medieval-mini:normandy rdf:type owl:NamedIndividual ,
                                medieval-mini:PoliticalTerritory ;
                       rdfs:label "Normandy"@en .


###  https://example.org/medieval-mini#williamI
medieval-mini:williamI rdf:type owl:NamedIndividual ,
                                medieval-mini:Person ;
                       medieval-mini:bornIn medieval-mini:falaise ;
                       medieval-mini:marriedTo medieval-mini:matildaOfFlanders ;
                       medieval-mini:ruledTerritory medieval-mini:england ,
                                                    medieval-mini:normandy ;
                       rdfs:label "William I of England"@en .


