@base <https://example.org/medieval-mini#> .

<https://example.org/medieval-mini> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://example.org/medieval-mini#birthplaceOf
medieval-mini:birthplaceOf rdf:type owl:ObjectProperty ;
                           owl:inverseOf medieval-mini:bornIn ;
                           rdf:type owl:AsymmetricProperty ;
                           rdfs:domain medieval-mini:Place ;
                           rdfs:range medieval-mini:Person .


###  https://example.org/medieval-mini#bornIn
medieval-mini:bornIn rdf:type owl:ObjectProperty ,
                              owl:AsymmetricProperty .


###  https://example.org/medieval-mini#childOf
medieval-mini:childOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf medieval-mini:descendantOf ;
                      rdf:type owl:AsymmetricProperty ;
                      rdfs:domain medieval-mini:Person ;
                      rdfs:range medieval-mini:Person .


###  https://example.org/medieval-mini#descendantOf
medieval-mini:descendantOf rdf:type owl:ObjectProperty ,
                                    owl:TransitiveProperty ;
                           rdfs:domain medieval-mini:Person ;
                           rdfs:range medieval-mini:Person .


###  https://example.org/medieval-mini#heldTitle
medieval-mini:heldTitle rdf:type owl:ObjectProperty ,
                                 owl:AsymmetricProperty ;
                        rdfs:domain medieval-mini:Person ;
                        rdfs:range medieval-mini:Title .


###  https://example.org/medieval-mini#locatedIn
medieval-mini:locatedIn rdf:type owl:ObjectProperty ,
                                 owl:AsymmetricProperty ;
                        rdfs:domain medieval-mini:Place ;
                        rdfs:range medieval-mini:Place .


###  https://example.org/medieval-mini#marriedTo
medieval-mini:marriedTo rdf:type owl:ObjectProperty ,
                                 owl:SymmetricProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain medieval-mini:Person ;
                        rdfs:range medieval-mini:Person .


###  https://example.org/medieval-mini#memberOfDynasty
medieval-mini:memberOfDynasty rdf:type owl:ObjectProperty ,
                                       owl:AsymmetricProperty ;
                              rdfs:domain medieval-mini:Person ;
                              rdfs:range medieval-mini:Dynasty .


###  https://example.org/medieval-mini#occurredIn
medieval-mini:occurredIn rdf:type owl:ObjectProperty ,
                                  owl:AsymmetricProperty ;
                         rdfs:domain medieval-mini:HistoricalEvent ;
                         rdfs:range medieval-mini:Place .


###  https://example.org/medieval-mini#participatedIn
medieval-mini:participatedIn rdf:type owl:ObjectProperty ,
                                      owl:AsymmetricProperty ;
                             rdfs:domain medieval-mini:Person ;
                             rdfs:range medieval-mini:HistoricalEvent .


###  https://example.org/medieval-mini#producedIn
medieval-mini:producedIn rdf:type owl:ObjectProperty ,
                                  owl:AsymmetricProperty ;
                         rdfs:domain medieval-mini:Manuscript ;
                         rdfs:range medieval-mini:Place .


###  https://example.org/medieval-mini#ruledTerritory
medieval-mini:ruledTerritory rdf:type owl:ObjectProperty ,
                                      owl:AsymmetricProperty ;
                             rdfs:domain medieval-mini:Person ;
                             rdfs:range medieval-mini:PoliticalTerritory .


###  https://example.org/medieval-mini#siblingOf
medieval-mini:siblingOf rdf:type owl:ObjectProperty ,
                                 owl:SymmetricProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain medieval-mini:Person ;
                        rdfs:range medieval-mini:Person .


###  https://example.org/medieval-mini#writtenInLanguage
medieval-mini:writtenInLanguage rdf:type owl:ObjectProperty ,
                                         owl:AsymmetricProperty ;
                                rdfs:domain medieval-mini:Manuscript ;
                                rdfs:range medieval-mini:Language .


